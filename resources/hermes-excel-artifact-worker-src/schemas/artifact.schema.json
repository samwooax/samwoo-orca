{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samwoo-orca.invalid/excel-artifact/v1/artifact.schema.json",
  "title": "Orca Excel Artifact v1 registry artifact metadata",
  "description": "Main-owned metadata for an opaque artifact. Private filesystem paths and bytes are never part of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "displayName",
    "mimeType",
    "size",
    "sha256",
    "owner",
    "conversationId",
    "requestId",
    "allowedConsumers",
    "allowedOperations",
    "source",
    "createdAt",
    "expiresAt",
    "cleanupStatus"
  ],
  "properties": {
    "artifactId": {
      "$ref": "definitions.schema.json#/$defs/artifactId"
    },
    "displayName": {
      "$ref": "definitions.schema.json#/$defs/safeFileName"
    },
    "mimeType": {
      "$ref": "definitions.schema.json#/$defs/mediaType"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "sha256": {
      "$ref": "definitions.schema.json#/$defs/sha256"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowedConsumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "create",
          "modify",
          "validate",
          "render",
          "cancel"
        ]
      }
    },
    "source": {
      "enum": [
        "attachment",
        "picker",
        "paste",
        "workspace",
        "jobOutput",
        "preview",
        "report"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "cleanupStatus": {
      "enum": [
        "pending",
        "removed",
        "failed"
      ]
    }
  }
}
